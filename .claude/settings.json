{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Edit",
      "Write",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(next *)",
      "Bash(prisma *)",
      "Bash(python *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./src/generated/**)",
      "Edit(./src/generated/**)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(prisma migrate reset *)",
      "Bash(prisma db push *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": ["playwright"]
}
